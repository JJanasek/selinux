policy_module(mlssemanageaccess, 1.0)

# checkpolicy_t and semanage_t both get their broad "read/relabel almost
# any admin-created content" access under Fedora's targeted policy from
# optional_policy(`unconfined_domain($1)') in selinuxutil.te, not from any
# MLS-aware, checkpolicy/semanage-specific rule. MLS ships no unconfined
# module at all, so that optional_policy block never fires there, and
# both domains are left with only the narrow set of rules selinuxutil.te
# grants them directly -- which does not include map on generic content
# (needed by the dynamic linker's own mmap of /etc/ld.so.cache, and by
# semanage_direct_install_file()'s mmap-based read of a module's .pp
# file) or relabelfrom on the module store (needed by every
# `semodule -i`, which relabels pre-existing store entries as part of
# committing a new module). This is invisible under targeted (root's
# login is unconfined_t there), but hits immediately under MLS once an
# admin logs in as the confined sysadm_t and runs semodule/checkpolicy
# directly, e.g. selinux-testsuite's `make -C policy load`.
#
# Confirmed via ausearch (Testing Farm request
# a61990ea-0d68-4790-9891-0d45bc3a8f2f): both domains keep sysadm_t's own
# full clearance range (s0-s15:c0.c1023) as their own context (expected --
# neither has a range_transition, nor needs one: MLS's own mlsconstrain
# rules for map and for these particular relabelfrom targets both
# already pass at that range against these single-level (s0) target
# types, e.g. the file "write" ops constraint's l1 eq l2 clause: s0 eq
# s0). The denials are plain type-enforcement gaps, not MLS range/level
# ones.

gen_require(`
	type checkpolicy_t, semanage_t;
	type etc_t, semanage_store_t, var_t;
')

allow checkpolicy_t etc_t:file map;

allow semanage_t etc_t:file map;
allow semanage_t semanage_store_t:{ dir file } relabelfrom;
allow semanage_t var_t:file map;
