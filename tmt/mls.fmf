summary: MLS Policy Enforcing-Mode Boot Validation
description: |
    Validates that a Fedora guest can be switched from the default targeted
    SELinux policy to mls and boot to a working SSH session in enforcing mode,
    with cloud-init and networking functional.

    Applies necessary workarounds for an unresolved udev/NetworkManager
    MLS timing race (permissive marks + fstab tuning) and loads custom
    policy modules to patch missing upstream MLS rules.

prepare:
  - name: Install and configure MLS policy in Permissive mode
    how: shell
    script: |
      dnf install -y selinux-policy-mls policycoreutils-python-utils audit

      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_configure

      # Stay permissive for the initial relabel reboot
      sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config

      # Preserve SSH host keys across reboots to maintain tmt connection
      mkdir -p /etc/cloud/cloud.cfg.d
      echo 'ssh_deletekeys: false' > /etc/cloud/cloud.cfg.d/99-preserve-ssh-host-keys.cfg

      # DIAGNOSTIC: cloud-init's single-process model finishes (and often
      # exits entirely) within ~10s of boot -- long before this plan's SSH
      # execute step reconnects -- so `ps -eZ` after boot can never catch it
      # and journald's per-message _SELINUX_CONTEXT has proven unreliable to
      # grep for it too. bootcmd runs a subprocess (`sh -c ...`) directly
      # from inside the cloud-init process itself, inheriting its live
      # domain with no exec transition of its own (sh has no cloudform
      # entrypoint type), so `id -Z` here is a first-hand, non-racy capture
      # of the domain cloud-init actually executed in.
      cat > /etc/cloud/cloud.cfg.d/98-selinux-context-check.cfg <<'CICFG'
      bootcmd:
        - [ sh, -c, "id -Z > /var/log/cloud-init-selinux-context.log 2>&1" ]
      CICFG

      # Reset cloud-init state to force a full run under MLS
      cloud-init clean --logs

  - name: Build and load cloud-init and sshd-session-pipes policy fixes
    how: shell
    script: |
      dnf install -y policycoreutils-devel

      # Stage missing interface files
      cp $TMT_TREE/tmt/mls-cloudinit-fix/networkmanager-manage-rw-conf.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/ssh-read-server-keys.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/sysnetwork-manage-config-sockets.if /usr/share/selinux/devel/include/system/

      mkdir -p /root/build && cd /root/build
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.* .
      cp $TMT_TREE/tmt/mls-ssh-pipes-fix/mlssshpipes.te .
      cp $TMT_TREE/tmt/mls-udev-ptrace-fix/udevptrace.te .

      make -f /usr/share/selinux/devel/Makefile cloudform.pp mlssshpipes.pp udevptrace.pp

      # Load modules into the inactive MLS store (-n) without hot-reloading
      semodule -n -i cloudform.pp mlssshpipes.pp udevptrace.pp
      semodule -l | grep -E '^(cloudform|mlssshpipes|udevptrace)\b'

  - name: Reboot to apply MLS and relabel
    how: shell
    script: |
      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_reboot
      prepare_for_mls_force_relabel

  - name: Switch to Enforcing and reboot again
    how: shell
    script: |
      if [ "${TMT_REBOOT_COUNT:-0}" -eq 0 ]; then
          rm -f /.autorelabel
          systemctl mask selinux-autorelabel.service

          # ROUND 7 RECHECK (c8c297aa, reverted here): re-tested whether
          # udev_t/NetworkManager_t are genuinely policy-unfixable now that
          # 66856419/9fb65dd8 proved our own "-ts boot"/"-ts recent"
          # ausearch invocations had a real, confirmed blind spot elsewhere
          # in this investigation. Result: identical to rounds 1-6 -- a
          # marks-dropped boot (request e9374c8e) still times out with the
          # same dev-disk-by-uuid device timeout -> local-fs.target collapse
          # -> emergency mode signature, and the corrected diagnostic still
          # found zero udev_t/NetworkManager_t AVCs. This time the evidence
          # doesn't even depend on ausearch's timestamp handling at all: the
          # serial console log captures every AVC the kernel's own audit
          # printk fallback emits in real time (kauditd_printk_skb), for the
          # whole boot, independent of any post-boot query. It shows several
          # real denials (systemd_tmpfiles_t missing self:capability
          # net_admin, init_t->initrc_t process:siginh, assorted pre-existing
          # generator kmsg-write gaps also seen in round 2/a51f2122) -- so
          # the pipeline demonstrably had every opportunity to log a udev_t
          # or NetworkManager_t denial too, and again never did.
          #
          # Also tried attacking rounds 1-6's "no console shell available"
          # blocker head-on this round: set a root password (sulogin refuses
          # a locked/empty hash) and systemd.debug-shell=1 (an always-on
          # root shell on tty9) specifically so a live setenforce-0 retry --
          # the technique that found the real cloud-init AVCs -- would be
          # possible if this hung the same way again. It did hang the same
          # way again, and the "Enter root password for system maintenance"
          # prompt is visible in the captured console log, but neither this
          # plan nor this investigator's tooling has any interactive channel
          # into Testing Farm's console (confirmed directly: no matching
          # libvirt domain reachable from qemu:///session either) to type
          # that password in. So the live-retry technique genuinely cannot
          # be applied to this failure mode the way it was for cloud-init --
          # that bug still had a full SSH session to retry commands over;
          # this one fails before any shell, local or remote, exists at all.
          # Conclusion stands, now confirmed by two independent, ausearch-
          # timestamp-independent methods (this console capture, and round
          # 4's direct sesearch --dontaudit verification): restoring both
          # marks and the fstab workaround as the correct fix.

          # WORKAROUND: Mitigate udev MLS overhead timing race.
          # Resolve fstab UUIDs to raw devices and extend timeouts to prevent local-fs.target collapse.
          cp /etc/fstab /etc/fstab.orig
          awk '!/^#/ && NF >= 4 && $3 != "swap" && $1 ~ /^UUID=/ { sub(/^UUID=/, "", $1); print $1 }' /etc/fstab.orig | sort -u | while read -r uuid; do
              dev=$(blkid -U "$uuid" 2>/dev/null) && [ -n "$dev" ] && sed -i "s#UUID=$uuid#$dev#g" /etc/fstab
          done
          cp /etc/fstab /etc/fstab.rewritten
          awk '!/^#/ && NF >= 4 && $3 != "swap" { $4 = $4",nofail,x-systemd.device-timeout=90" } { print }' /etc/fstab.rewritten > /etc/fstab

          # WORKAROUND: Mark timing-sensitive domains permissive.
          # Disabling dontaudit ensures we catch any hidden AVCs.
          semanage permissive -n -a udev_t
          semanage permissive -n -a NetworkManager_t
          semanage dontaudit off -N

          # WORKAROUND (kept as defense-in-depth alongside the real fix in
          # cloudform.te): cloud-init-generator's own runtime enablement
          # step (writing a symlink into /run/systemd/generator.early/
          # multi-user.target.wants/) reliably failed on this image --
          # /run/cloud-init/cloud-init-generator.log showed "failed to make
          # dir ... [1] enable failed: ln ...". This first looked like a
          # non-SELinux bug (ausearch -ts boot came back clean), but that
          # was a false negative in our own diagnostics: -ts boot silently
          # missed real, already-occurring AVCs that -ts recent later
          # caught (see the socket-permission investigation below in the
          # execute step) -- cloudform.te now grants cloud_init_t the
          # missing manage rights on systemd_generator_unit_file_t so the
          # generator's own symlink succeeds. This static symlink stays as
          # a low-cost second path to the same end state, since
          # cloud-init.target ships with no static [Install] section by
          # design (meant to be enabled purely by the generator).
          mkdir -p /etc/systemd/system/multi-user.target.wants
          ln -sf /usr/lib/systemd/system/cloud-init.target /etc/systemd/system/multi-user.target.wants/cloud-init.target

          # Use -DB to guarantee a policy rebuild without silently restoring dontaudit rules
          semodule -DB

          # Raise audit backlog so early-boot AVCs survive for the verification step
          grubby --update-kernel=ALL --args="audit_backlog_limit=8192"

          cloud-init clean --logs
          sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
          tmt-reboot -t 1200
      fi

  - name: Verify enforcing-mode boot
    how: shell
    script: |
      echo "=== SELinux status ==="
      sestatus

      echo "=== dmesg | grep -i 'avc:\|denied' ==="
      dmesg 2>&1 | grep -i 'avc:\|denied' || echo "no matches in dmesg"

      echo "=== journalctl -k -b | grep -i 'avc:\|denied' ==="
      journalctl -k -b 2>&1 | grep -i 'avc:\|denied' || echo "no matches in journalctl"

      echo "=== AVC/USER_AVC denials this boot (ausearch) ==="
      # NOTE: "-ts boot" has proven unreliable here -- it silently missed
      # real AVCs that computing the actual boot time caught (see the
      # cloud-init socket-permission investigation in the execute step).
      boot_ts=$(date -d "$(uptime -s)" '+%m/%d/%Y %H:%M:%S' 2>/dev/null || echo recent)
      ausearch -m AVC,USER_AVC -ts "$boot_ts" 2>&1 || echo "no AVCs this boot"

      echo "=== any AVCs naming udev_t or NetworkManager_t specifically ==="
      # Rounds 1-6 concluded "not fixable via policy" from this exact query
      # coming back empty every time, but using "-ts boot"/"-ts recent",
      # both since proven to miss real AVCs (66856419/9fb65dd8). Round 7
      # re-ran this with the corrected boot_ts above (plus, independently,
      # a full serial-console kauditd_printk_skb capture -- see the
      # permissive-mark comments above) and still found nothing for either
      # domain. Kept permanently: marks make udev_t/NetworkManager_t immune
      # to enforcement, but permissive domains still log what would have
      # been denied (permissive=1), so this stays a free early-warning check
      # for any future re-litigation of the marks.
      ausearch -m AVC,USER_AVC -ts "$boot_ts" 2>/dev/null | grep -Ei 'udev_t|NetworkManager_t' || echo "none"

execute:
  how: tmt
  script: |
    echo "=== SELinux status ==="
    sestatus

    echo "=== waiting (up to 120s) for cloud-init to finish ==="
    timeout 120 cloud-init status --wait || true

    echo "=== cloud-init result ==="
    long_status=$(cloud-init status --long) || true
    echo "$long_status"

    echo "=== cloud-init running domain (expected: cloud_init_t) ==="
    ps -eZ | grep -i cloud || true

    # DIAGNOSTIC: cloud-init's boot activation is generator-only --
    # cloud-init.target ships with no static [Install] section, so it
    # relies on cloud-init-generator (or the static symlink workaround
    # above) pulling it into the boot transaction. Keeping these
    # permanently: "did cloud-init actually finish" needs a real check
    # every run, not just a passing diagnostic script.
    echo "=== cloud-init unit enablement/status ==="
    systemctl list-unit-files 'cloud-init*' 'cloud-config*' 'cloud-final*' || true
    systemctl status --no-pager cloud-init-local.service cloud-init-main.service cloud-config.service cloud-final.service || true

    echo "=== is cloud-init.target actually enabled/pulled into the boot? ==="
    systemctl show cloud-init.target -p ActiveState -p Wants || true
    ls -la /etc/systemd/system/multi-user.target.wants/cloud-init.target /run/systemd/generator*/multi-user.target.wants/cloud-init.target 2>&1 || true

    echo "=== cloud-init-generator's own log (ds-identify trace, written pre-journald) ==="
    cat /run/cloud-init/cloud-init-generator.log 2>&1 || echo "no cloud-init-generator.log"

    # DIAGNOSTIC: cloud-init-main.service listens on unix sockets under
    # /run/cloud-init/share (labeled net_conf_t, no cloudform-owned type
    # exists for it) for its stage shims (running as initrc_t) to signal
    # "start". cloudform.te now grants that connectto/write cross-domain,
    # but keep this cheap ls around -- it is exactly what exposed the gap
    # last time and costs nothing to check on every run.
    echo "=== /run/cloud-init/share ownership and SELinux labels ==="
    ls -laZ /run/cloud-init/share 2>&1 || true

    echo "=== failed units / stuck jobs this boot ==="
    systemctl --failed --no-pager || true
    systemctl list-jobs || true

    echo "=== journal for all cloud-init/cloud-config/cloud-final units ==="
    journalctl -u 'cloud-init*' -u 'cloud-config*' -u 'cloud-final*' -b --no-pager || true

    echo "=== audit2allow suggestions for any denials above ==="
    # NOTE: "-ts boot" silently missed real AVCs earlier in this same
    # investigation, and "-ts recent" (a fixed 10-minute window) can reach
    # back far enough to catch stale pre-MLS-switch entries whose
    # unconfined_u user context no longer exists under this loaded MLS
    # policy, which makes audit2allow choke and stop producing useful
    # output. Compute the actual current boot's start time instead, so
    # this only ever looks at AVCs from this boot.
    boot_ts=$(date -d "$(uptime -s)" '+%m/%d/%Y %H:%M:%S' 2>/dev/null || echo recent)
    ausearch -m AVC -ts "$boot_ts" 2>/dev/null | audit2allow || true

    echo "=== any AVCs naming cloud_init_t specifically (raw, in case audit2allow above choked) ==="
    ausearch -m AVC -ts "$boot_ts" 2>/dev/null | grep -i cloud_init_t || echo "none"

    # REAL VERIFICATION: unlike everything above, this is not `|| true`.
    # Whether cloud-init actually finished under cloud_init_t is the
    # actual point of this plan -- a tmt "passed" verdict should mean
    # that happened, not just that the diagnostic script didn't crash.
    echo "=== final cloud-init verification ==="
    final_status=$(echo "$long_status" | awk -F': ' '/^status:/ {print $2}')
    echo "final status: $final_status"
    if [ "$final_status" != "done" ]; then
        echo "FAIL: cloud-init did not reach 'done' (got: '$final_status')"
        exit 1
    fi
    # cloud-init-main.service is short-lived (often gone within ~10s of
    # boot, well before this SSH execute step reconnects), so both `ps -eZ`
    # and journald's per-message SELinux context proved too racy/unreliable
    # to catch it after the fact. Instead read back the bootcmd-captured
    # `id -Z`, which ran as a direct subprocess of cloud-init itself (see
    # 98-selinux-context-check.cfg in prepare) and so reflects the domain
    # cloud-init genuinely executed in, not a snapshot taken after it exited.
    echo "=== cloud-init's own SELinux context (captured via bootcmd) ==="
    context_log=$(cat /var/log/cloud-init-selinux-context.log 2>&1) || true
    echo "$context_log"
    if ! echo "$context_log" | grep -q cloud_init_t; then
        echo "FAIL: cloud-init reported done, but no evidence it ever ran under cloud_init_t"
        exit 1
    fi
    echo "PASS: cloud-init reached 'done' and ran under cloud_init_t"
