summary: MLS Policy Enforcing-Mode Boot Validation
description: |
    Validates that a Fedora guest can be switched from the default targeted
    SELinux policy to mls and boot to a working SSH session in enforcing mode,
    with cloud-init and networking functional.

    EXPERIMENT (round 6): testing whether raising systemd-udevd's own
    per-worker event_timeout (plus the systemd-udevd/NetworkManager
    service timeouts) fixes the udev/NetworkManager MLS timing race
    without the udev_t/NetworkManager_t permissive marks + fstab tuning
    used in rounds 1-5. Also loads custom policy modules to patch
    missing upstream MLS rules.

prepare:
  - name: Install and configure MLS policy in Permissive mode
    how: shell
    script: |
      dnf install -y selinux-policy-mls policycoreutils-python-utils audit

      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_configure

      # Stay permissive for the initial relabel reboot
      sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config

      # Preserve SSH host keys across reboots to maintain tmt connection
      mkdir -p /etc/cloud/cloud.cfg.d
      echo 'ssh_deletekeys: false' > /etc/cloud/cloud.cfg.d/99-preserve-ssh-host-keys.cfg

      # Reset cloud-init state to force a full run under MLS
      cloud-init clean --logs

  - name: Build and load cloud-init and sshd-session-pipes policy fixes
    how: shell
    script: |
      dnf install -y policycoreutils-devel

      # Stage missing interface files
      cp $TMT_TREE/tmt/mls-cloudinit-fix/networkmanager-manage-rw-conf.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/ssh-read-server-keys.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/sysnetwork-manage-config-sockets.if /usr/share/selinux/devel/include/system/

      mkdir -p /root/build && cd /root/build
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.* .
      cp $TMT_TREE/tmt/mls-ssh-pipes-fix/mlssshpipes.te .
      cp $TMT_TREE/tmt/mls-udev-ptrace-fix/udevptrace.te .

      make -f /usr/share/selinux/devel/Makefile cloudform.pp mlssshpipes.pp udevptrace.pp

      # Load modules into the inactive MLS store (-n) without hot-reloading
      semodule -n -i cloudform.pp mlssshpipes.pp udevptrace.pp
      semodule -l | grep -E '^(cloudform|mlssshpipes|udevptrace)\b'

  - name: Reboot to apply MLS and relabel
    how: shell
    script: |
      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_reboot
      prepare_for_mls_force_relabel

  - name: Switch to Enforcing and reboot again
    how: shell
    script: |
      if [ "${TMT_REBOOT_COUNT:-0}" -eq 0 ]; then
          rm -f /.autorelabel
          systemctl mask selinux-autorelabel.service

          # EXPERIMENT (round 6): rounds 1-5 confirmed (via ausearch, dmesg,
          # journalctl -k -b, journalctl -b, journalctl -b -1 -k, and direct
          # sesearch --dontaudit verification with dontaudit genuinely off)
          # that dropping udev_t/NetworkManager_t permissive marks reliably
          # reproduces a dev-nvme0n1p2/p3.device timeout -> local-fs.target
          # failure with ZERO AVC denials anywhere, and that raising the
          # *systemd unit*/mount timeout (x-systemd.device-timeout, the
          # tmt-reboot ceiling) never fixes it -- the device job just retries
          # in a loop until tmt gives up. That loop signature is exactly what
          # you'd see if systemd-udevd's own internal per-worker event_timeout
          # (separate from any unit-level timeout) is killing the worker
          # before it finishes genuinely-slower work under MLS's heavier
          # per-syscall dominance-math overhead -- userspace killing its own
          # legitimate work, not SELinux denying anything.
          #
          # Verified against this exact image (Fedora 44, systemd-259.8, via
          # `man udev.conf`): the compiled-in default event_timeout is 180s,
          # not the ~60s commonly assumed from older docs. Raising it well
          # past that baseline here.
          echo 'event_timeout=300' >> /etc/udev/udev.conf

          # TimeoutStartSec/TimeoutStopSec only gate systemd-udevd's own
          # start/stop handshake, not per-worker event processing (that's
          # event_timeout above) -- raised anyway as cheap insurance in case
          # daemon start/stop itself is what's slow under MLS.
          mkdir -p /etc/systemd/system/systemd-udevd.service.d
          cp $TMT_TREE/tmt/mls-udev-timeout-fix/systemd-udevd-timeout.conf \
              /etc/systemd/system/systemd-udevd.service.d/99-mls-timeout.conf

          # NetworkManager.service already ships TimeoutStartSec=600
          # upstream (verified via `systemctl cat NetworkManager.service` on
          # this image) -- already above the naive 300s value, so raising it
          # further to 900s instead of regressing it down to 300s.
          mkdir -p /etc/systemd/system/NetworkManager.service.d
          cp $TMT_TREE/tmt/mls-udev-timeout-fix/NetworkManager-timeout.conf \
              /etc/systemd/system/NetworkManager.service.d/99-mls-timeout.conf

          systemctl daemon-reload

          # dontaudit off ensures we still catch any hidden AVCs if this
          # theory turns out to be wrong.
          semanage dontaudit off -N

          # Use -DB to guarantee a policy rebuild without silently restoring dontaudit rules
          semodule -DB

          # Raise audit backlog so early-boot AVCs survive for the verification step
          grubby --update-kernel=ALL --args="audit_backlog_limit=8192"

          cloud-init clean --logs
          sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
          tmt-reboot -t 1200
      fi

  - name: Verify enforcing-mode boot
    how: shell
    script: |
      echo "=== SELinux status ==="
      sestatus

      echo "=== dmesg | grep -i 'avc:\|denied' ==="
      dmesg 2>&1 | grep -i 'avc:\|denied' || echo "no matches in dmesg"

      echo "=== journalctl -k -b | grep -i 'avc:\|denied' ==="
      journalctl -k -b 2>&1 | grep -i 'avc:\|denied' || echo "no matches in journalctl"

      echo "=== AVC/USER_AVC denials this boot (ausearch) ==="
      ausearch -m AVC,USER_AVC -ts boot 2>&1 || echo "no AVCs this boot"

      echo "=== journalctl -k -b: udev worker timeout/kill evidence ==="
      journalctl -k -b 2>&1 | grep -iE 'timeout|killing|worker.*fail|timeout expired' || echo "no udev worker timeout/kill messages this boot"

      echo "=== current event_timeout / service timeout settings in effect ==="
      grep -H event_timeout /etc/udev/udev.conf || echo "event_timeout not set in udev.conf"
      systemctl show systemd-udevd.service -p TimeoutStartUSec -p TimeoutStopUSec
      systemctl show NetworkManager.service -p TimeoutStartUSec -p TimeoutStopUSec

execute:
  how: tmt
  script: |
    echo "=== SELinux status ==="
    sestatus

    echo "=== waiting (up to 120s) for cloud-init to finish ==="
    timeout 120 cloud-init status --wait || true

    echo "=== cloud-init result ==="
    cloud-init status --long || true

    echo "=== cloud-init running domain (expected: cloud_init_t) ==="
    ps -eZ | grep -i cloud || true

    # DIAGNOSTIC: cloud-init never leaves "not started" even after the wait
    # above, with zero AVCs naming it anywhere -- so the next questions are
    # whether systemd ever actually queued its units into the boot
    # transaction at all (vs. them being enabled-but-never-pulled-in), and
    # whether anything upstream in their dependency chain is stuck/failed.
    echo "=== cloud-init unit enablement (static WantedBy symlinks) ==="
    systemctl list-unit-files 'cloud-init*' 'cloud-config*' 'cloud-final*' || true

    echo "=== cloud-init stage unit status (active/failed/masked?) ==="
    systemctl status --no-pager --full cloud-init-local.service cloud-init.service cloud-config.service cloud-final.service || true

    echo "=== full unit definitions incl. any generator drop-ins (Requires/Wants/After/Before) ==="
    systemctl cat cloud-init-local.service cloud-init.service cloud-config.service cloud-final.service || true

    echo "=== cloud-init.target dependency tree (is a dependency failed/inactive?) ==="
    systemctl list-dependencies cloud-init.target --all || true

    echo "=== any systemd jobs still stuck/waiting ==="
    systemctl list-jobs || true

    echo "=== all failed units this boot ==="
    systemctl --failed --no-pager || true

    echo "=== cloud-init-generator journal (ds-identify's enable/disable decision) ==="
    journalctl -u cloud-init-generator -b --no-pager || true

    echo "=== journal for all cloud-init/cloud-config/cloud-final units ==="
    journalctl -u 'cloud-init*' -u 'cloud-config*' -u 'cloud-final*' -b --no-pager || true

    echo "=== audit2allow suggestions for any denials above ==="
    ausearch -m AVC -ts boot 2>/dev/null | audit2allow || true
