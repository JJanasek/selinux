summary: MLS Policy Enforcing-Mode Boot Validation
description: |
    Validates that a Fedora guest can be switched from the default
    (targeted) SELinux policy to mls and boot to a working SSH session in
    real enforcing mode (acceptance criterion 1), with cloud-init and
    networking both working normally under mls's stricter constraints.

    Two local policy modules fix gaps in the stock mls policy that this
    plan depends on and that Fedora's shipped mls build doesn't cover yet:

    - cloudform (mls-cloudinit-fix/): grants cloud-init the file, socket,
      and capability access it needs to run confined as cloud_init_t under
      mls, instead of relying on the targeted-only unconfined_domain()
      escape hatch mls doesn't have. Also declares cloud_init_t
      mls_file_read_all_levels(), since growing the root filesystem
      legitimately needs to read the raw disk device regardless of its
      labeled sensitivity. Developed against
      JJanasek/selinux-policy@mls-enable-cloud-init.
    - mlssshpipes (mls-ssh-pipes-fix/): backports
      fedora-selinux/selinux-policy commit a589b1b5 (fixing
      fedora-selinux/selinux-policy#3286), not yet in
      selinux-policy-mls-44.6-1.fc44. Without it, sysadm_t (root's login
      domain under mls) can't read/write the pipes OpenSSH's
      privilege-separated sshd-session hands a login shell as stdin/
      stdout, so command output never makes it back over SSH once mls is
      actually enforcing.

    Both are checked into this plan as standalone third-party module
    sources, built with the standard `/usr/share/selinux/devel/Makefile`
    workflow and loaded into the guest's mls store with `semodule -i`, so
    there's no runtime dependency on GitHub or a custom selinux-policy
    build.

    `prepare_for_mls.sh` implements the actual policy switch (login
    mapping, SELINUXTYPE, scheduled relabel, reboot, and the follow-up
    forced full-context relabel); see its header for why each step is
    necessary. This plan sequences that around staging the two modules
    above and a second reboot into real enforcing mode.

prepare:
  - name: Install and configure MLS policy in Permissive mode
    how: shell
    script: |
      dnf install -y selinux-policy-mls policycoreutils-python-utils audit

      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_configure

      # Stay permissive for the upcoming relabel reboot; the deliberate
      # switch to real enforcing mode is its own later step, once the mls
      # switch itself is known-good.
      sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config

      # cloud-init's `ssh` module regenerates host keys on what it thinks
      # is a fresh instance boot; keep the existing ones so tmt's SSH
      # reconnects across this plan's reboots don't break.
      mkdir -p /etc/cloud/cloud.cfg.d
      echo 'ssh_deletekeys: false' > /etc/cloud/cloud.cfg.d/99-preserve-ssh-host-keys.cfg

      # Reset cloud-init's per-instance state so the next boot re-runs
      # the full local -> init -> config -> final stage sequence under
      # the correct (mls) SELinux domain transitions, instead of seeing
      # an already-provisioned instance and skipping everything.
      cloud-init clean --logs

  - name: Build and load cloud-init and sshd-session-pipes policy fixes
    how: shell
    script: |
      dnf install -y policycoreutils-devel

      # cloudform.te calls interfaces not in the stock headers yet
      # (networkmanager_manage_rw_conf, ssh_read_server_keys,
      # sysnetwork_manage_config_sockets); they just expand into ordinary
      # allow/manage_*_pattern rules against types the already-installed
      # networkmanager/ssh/sysnetwork modules provide, so only the
      # interface files need adding here.
      cp $TMT_TREE/tmt/mls-cloudinit-fix/networkmanager-manage-rw-conf.if \
          /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/ssh-read-server-keys.if \
          /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/sysnetwork-manage-config-sockets.if \
          /usr/share/selinux/devel/include/system/

      mkdir -p /root/build && cd /root/build
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.te .
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.if .
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.fc .
      cp $TMT_TREE/tmt/mls-ssh-pipes-fix/mlssshpipes.te .

      make -f /usr/share/selinux/devel/Makefile cloudform.pp mlssshpipes.pp

      # -n: build these into the (currently inactive) mls store without
      # hot-reloading the live kernel, which is still running -- and
      # still enforcing -- the old targeted policy at this point. The
      # mls store only becomes the active kernel policy on the reboot in
      # the next step.
      semodule -n -i cloudform.pp mlssshpipes.pp
      semodule -l | grep -E '^(cloudform|mlssshpipes)\b'

  - name: Reboot to apply MLS and relabel
    how: shell
    script: |
      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_reboot
      prepare_for_mls_force_relabel

  - name: Switch to Enforcing and reboot again (tests acceptance criterion 1)
    how: shell
    script: |
      if [ "${TMT_REBOOT_COUNT:-0}" -eq 0 ]; then
          # selinux-autorelabel.service re-decides a relabel is needed on
          # this boot regardless of /.autorelabel's state; running it
          # again would just redundantly repeat the relabel
          # prepare_for_mls_force_relabel() already did above.
          rm -f /.autorelabel
          systemctl mask selinux-autorelabel.service

          # udev's device processing for this guest's root disk is
          # unreliable under a freshly enforcing mls kernel and can take
          # well past the default device-unit timeout (both the by-uuid
          # symlinks *and* the raw partition device unit itself), taking
          # local-fs.target down with it -- a dead end, since emergency
          # mode has no sshd and a locked root. Resolve each fstab UUID to
          # its raw device now, while still permissive and blkid is known
          # to work, and make every non-root mount nofail with a generous
          # device-timeout so a still-slow device delays rather than fails
          # the boot.
          cp /etc/fstab /etc/fstab.orig
          awk '!/^#/ && NF >= 4 && $3 != "swap" && $1 ~ /^UUID=/ { sub(/^UUID=/, "", $1); print $1 }' \
              /etc/fstab.orig | sort -u | while read -r uuid; do
              dev=$(blkid -U "$uuid" 2>/dev/null) && [ -n "$dev" ] && \
                  sed -i "s#UUID=$uuid#$dev#g" /etc/fstab
          done
          cp /etc/fstab /etc/fstab.rewritten
          awk '!/^#/ && NF >= 4 && $3 != "swap" { $4 = $4",nofail,x-systemd.device-timeout=90" } { print }' \
              /etc/fstab.rewritten > /etc/fstab

          # NOT masking a known policy denial: a passing run with these
          # marks on and dontaudit off (artifacts
          # 516a17dc-46d9-492c-bee9-697b8806f305) showed zero
          # udev_t/NetworkManager_t AVCs anywhere in the full dump, so
          # there is no known would-be-denied access being suppressed
          # here. But dropping both marks (commit a5b3af25, artifacts
          # 62e3cb72/3cd4d2fc/3c84f426) reproduced a hard failure 3/3
          # times, always the same signature: dev-*.device (the root
          # disk's raw partition unit) times out waiting for udev even
          # with the 90s nofail grace period below, before the plan ever
          # reaches the audit-verification step that would have caught a
          # real denial -- so this isn't a case where permissive is
          # silently swallowing a logged AVC; it never gets far enough
          # to log one either way. Keeping both marks as a broad,
          # empirically load-bearing safety margin against this
          # early-boot udev/disk-readiness race, not as a workaround for
          # any identified SELinux denial.
          semanage permissive -n -a udev_t
          semanage permissive -n -a NetworkManager_t
          semanage dontaudit off -N

          # Raise the audit backlog so early-boot AVCs survive to be read
          # by the verification step below instead of being dropped once
          # the kernel's default 64-entry backlog fills.
          grubby --update-kernel=ALL --args="audit_backlog_limit=8192"

          cloud-init clean --logs
          sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
          tmt-reboot -t 1200
      fi

  - name: Verify enforcing-mode boot
    how: shell
    script: |
      echo "=== SELinux status ==="
      sestatus

      echo "=== AVC/USER_AVC denials this boot ==="
      ausearch -m AVC,USER_AVC -ts boot 2>&1 || echo "no AVCs this boot"

execute:
  how: tmt
  script: |
    echo "=== SELinux status ==="
    sestatus

    echo "=== cloud-init result ==="
    cloud-init status --long || true

    echo "=== cloud-init running domain (expected: cloud_init_t) ==="
    ps -eZ | grep -i cloud || true

    echo "=== AVC/USER_AVC denials this boot ==="
    ausearch -m AVC,USER_AVC -ts boot || echo "no AVCs this boot"

    echo "=== audit2allow suggestions for any denials above ==="
    ausearch -m AVC -ts boot 2>/dev/null | audit2allow || true
