summary: MLS Policy Investigation Plan

prepare:
  - name: Install MLS policy and tools
    how: shell
    script: |
      dnf install -y selinux-policy-mls policycoreutils-python-utils audit
      semanage login -m -s sysadm_u root
      sed -i 's/^SELINUXTYPE=.*/SELINUXTYPE=mls/' /etc/selinux/config
      touch /.autorelabel

  - name: Reboot into MLS policy
    how: shell
    script: tmt-reboot

execute:
  how: tmt
  script: |
    setenforce 0 || true
    cloud-init clean --logs
    cloud-init init || true
    echo "=== CAPTURED AVC DENIALS ==="
    ausearch -m AVC,USER_AVC -ts boot || true
    ausearch -m AVC -ts boot | audit2allow || true
