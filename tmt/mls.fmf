summary: MLS Policy Enforcing-Mode Boot Validation
description: |
    Validates that a Fedora guest can be switched from the default targeted
    SELinux policy to mls and boot to a working SSH session in enforcing mode,
    with cloud-init and networking functional.

    Applies necessary workarounds for an unresolved udev/NetworkManager
    MLS timing race (permissive marks + fstab tuning) and loads custom
    policy modules to patch missing upstream MLS rules.

prepare:
  - name: Install and configure MLS policy in Permissive mode
    how: shell
    script: |
      dnf install -y selinux-policy-mls policycoreutils-python-utils audit

      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_configure

      # Stay permissive for the initial relabel reboot
      sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config

      # Preserve SSH host keys across reboots to maintain tmt connection
      mkdir -p /etc/cloud/cloud.cfg.d
      echo 'ssh_deletekeys: false' > /etc/cloud/cloud.cfg.d/99-preserve-ssh-host-keys.cfg

      # DIAGNOSTIC: cloud-init's single-process model finishes (and often
      # exits entirely) within ~10s of boot -- long before this plan's SSH
      # execute step reconnects -- so `ps -eZ` after boot can never catch it
      # and journald's per-message _SELINUX_CONTEXT has proven unreliable to
      # grep for it too. bootcmd runs a subprocess (`sh -c ...`) directly
      # from inside the cloud-init process itself, inheriting its live
      # domain with no exec transition of its own (sh has no cloudform
      # entrypoint type), so `id -Z` here is a first-hand, non-racy capture
      # of the domain cloud-init actually executed in.
      cat > /etc/cloud/cloud.cfg.d/98-selinux-context-check.cfg <<'CICFG'
      bootcmd:
        - [ sh, -c, "id -Z > /var/log/cloud-init-selinux-context.log 2>&1" ]
      CICFG

      # Reset cloud-init state to force a full run under MLS
      cloud-init clean --logs

  - name: Build and load cloud-init and sshd-session-pipes policy fixes
    how: shell
    script: |
      dnf install -y policycoreutils-devel

      # Stage missing interface files
      cp $TMT_TREE/tmt/mls-cloudinit-fix/networkmanager-manage-rw-conf.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/ssh-read-server-keys.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/sysnetwork-manage-config-sockets.if /usr/share/selinux/devel/include/system/

      mkdir -p /root/build && cd /root/build
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.* .
      cp $TMT_TREE/tmt/mls-ssh-pipes-fix/mlssshpipes.te .
      cp $TMT_TREE/tmt/mls-udev-ptrace-fix/udevptrace.te .

      make -f /usr/share/selinux/devel/Makefile cloudform.pp mlssshpipes.pp udevptrace.pp

      # Load modules into the inactive MLS store (-n) without hot-reloading
      semodule -n -i cloudform.pp mlssshpipes.pp udevptrace.pp
      semodule -l | grep -E '^(cloudform|mlssshpipes|udevptrace)\b'

  - name: Reboot to apply MLS and relabel
    how: shell
    script: |
      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_reboot
      prepare_for_mls_force_relabel

  - name: Switch to Enforcing and reboot again
    how: shell
    script: |
      if [ "${TMT_REBOOT_COUNT:-0}" -eq 0 ]; then
          rm -f /.autorelabel
          systemctl mask selinux-autorelabel.service

          # ROUND 8 CONFIRMED (46410f1c/76916137/92863e37/7ac1e9ac, this
          # commit reverts the temporary full-system-permissive diagnostic
          # back to the permanent enforcing state): rounds 1-7 all concluded
          # "no udev_t/NetworkManager_t AVCs anywhere" from ausearch queries
          # scoped to exactly those two scontext values. Round 8 broadened
          # the net once more before closing the book -- full-system
          # SELINUX=permissive plus a comprehensive scontext/tcontext/comm=/
          # object-class sweep (still in the verify step below, kept
          # permanently) -- and, once a real bug in the ausearch invocation
          # itself was found and fixed (7ac1e9ac: -ts needs date and time as
          # two separate arguments, not one merged string, or it silently
          # errors on every single query this plan has ever run), the sweep
          # genuinely executed against ~150 real AVC records and still found
          # nothing udev/NetworkManager-related beyond what rounds 1-7
          # already documented. Restoring the two domain-level marks below.
          #
          # WORKAROUND: Mark timing-sensitive domains permissive.
          # Disabling dontaudit ensures we catch any hidden AVCs.
          semanage permissive -n -a udev_t
          semanage permissive -n -a NetworkManager_t

          # REAL FIX (found via mls-fix-sysadm-permissive, a throwaway
          # diagnostic branch that marked sysadm_t/sshd_t/sshd_session_t
          # permissive just long enough to capture the actual denial --
          # not carried over here): root's SSH session under MLS maps to
          # sysadm_u/sysadm_r/sysadm_t (semanage login -l), but
          # policy/modules/services/ssh.te gates sshd_session_t's ability
          # to transition into any admin domain behind the tunable
          # `ssh_sysadm_login` (off by default -- a deliberate hardening
          # default, since most systems don't want SSH landing directly
          # in the admin role). With it off, every post-reboot SSH command
          # for root failed execve() with "avc: denied { transition } ...
          # scontext=sshd_session_t tcontext=sysadm_t tclass=process",
          # surfacing to the user as a flat "/bin/bash: Permission
          # denied" -- audit.log's own audit2allow output named this
          # boolean directly. This is not a udev/NetworkManager timing
          # issue and not an MLS range/constraint problem (scontext and
          # tcontext carry the identical s0-s15:c0.c1023 range); it is
          # simply a missing runtime policy toggle for this MLS root-
          # login setup. semanage persists to the policy store so this is
          # in effect for the enforcing-mode boot below.
          semanage boolean -n -m --on ssh_sysadm_login

          semanage dontaudit off -N

          # WORKAROUND: Mitigate udev MLS overhead timing race.
          # Resolve fstab UUIDs to raw devices and extend timeouts to prevent local-fs.target collapse.
          cp /etc/fstab /etc/fstab.orig
          awk '!/^#/ && NF >= 4 && $3 != "swap" && $1 ~ /^UUID=/ { sub(/^UUID=/, "", $1); print $1 }' /etc/fstab.orig | sort -u | while read -r uuid; do
              dev=$(blkid -U "$uuid" 2>/dev/null) && [ -n "$dev" ] && sed -i "s#UUID=$uuid#$dev#g" /etc/fstab
          done
          cp /etc/fstab /etc/fstab.rewritten
          awk '!/^#/ && NF >= 4 && $3 != "swap" { $4 = $4",nofail,x-systemd.device-timeout=90" } { print }' /etc/fstab.rewritten > /etc/fstab

          # WORKAROUND (kept as defense-in-depth alongside the real fix in
          # cloudform.te): cloud-init-generator's own runtime enablement
          # step (writing a symlink into /run/systemd/generator.early/
          # multi-user.target.wants/) reliably failed on this image --
          # /run/cloud-init/cloud-init-generator.log showed "failed to make
          # dir ... [1] enable failed: ln ...". This first looked like a
          # non-SELinux bug (ausearch -ts boot came back clean), but that
          # was a false negative in our own diagnostics: -ts boot silently
          # missed real, already-occurring AVCs that -ts recent later
          # caught (see the socket-permission investigation below in the
          # execute step) -- cloudform.te now grants cloud_init_t the
          # missing manage rights on systemd_generator_unit_file_t so the
          # generator's own symlink succeeds. This static symlink stays as
          # a low-cost second path to the same end state, since
          # cloud-init.target ships with no static [Install] section by
          # design (meant to be enabled purely by the generator).
          mkdir -p /etc/systemd/system/multi-user.target.wants
          ln -sf /usr/lib/systemd/system/cloud-init.target /etc/systemd/system/multi-user.target.wants/cloud-init.target

          # Use -DB to guarantee a policy rebuild without silently restoring dontaudit rules
          semodule -DB

          # ROUND 9: the leading theory for this hang -- genuine MLS
          # per-syscall overhead delaying udev device enumeration past
          # boot timeouts -- has never actually been observed; it's an
          # inference from elimination (rounds 1-8 ruled out AVCs, MLS
          # trust gaps, and range width, but never saw the failing boot
          # itself). The emergency-mode shell this hang lands in is a
          # dead end for post-mortem: root is locked and Testing Farm
          # gives no interactive console, so journalctl -b for that exact
          # boot is unreachable. The one channel that survives an
          # unreachable root shell is whatever systemd/udev write
          # directly to the serial console, which Testing Farm captures
          # independently of any guest access.
          #
          # Confirm the guest already has a serial console configured
          # before relying on it, rather than assume -- this Fedora cloud
          # image's own pre-login banner ("Kernel ... on x86_64 (ttyS0)",
          # observed in prior rounds' console logs) confirms agetty is
          # already running on ttyS0, which only happens if console=ttyS0
          # is on the kernel cmdline, but add it explicitly if somehow
          # missing so the debug logging below has somewhere to land.
          if ! grubby --info=DEFAULT | grep -q 'console=ttyS0'; then
              grubby --update-kernel=ALL --args="console=ttyS0,115200n8"
          fi

          # Raise audit backlog so early-boot AVCs survive for the
          # verification step, and force systemd/udev to dump everything
          # to that serial console at debug verbosity so a repeat of this
          # hang leaves real evidence instead of silence: an explicit
          # udev worker timeout/kill message would confirm a userspace
          # timeout-and-kill; a kernel hung_task/"blocked for more than N
          # seconds" message (or the log simply stopping mid-line with no
          # further kernel activity) would instead point to a kernel-level
          # stall; an explicit ATA/NVMe/block-layer error would point to
          # I/O starvation; and a udev-internal event-processing error at
          # debug level would point to a race/bug in udev itself rather
          # than any of the above.
          grubby --update-kernel=ALL --args="audit_backlog_limit=8192 systemd.journald.forward_to_console=1 systemd.log_level=debug udev.log_level=debug systemd.debug_shell=ttyS0"
          echo "=== confirm all kernel args landed on the default boot entry ==="
          grubby --info=DEFAULT | grep args

          # NEW: passive, non-interactive diagnostic dumper. Every avenue for
          # *interacting* with the guest during the hang has failed --
          # Testing Farm's serial console goes silent with no way to type
          # into it once the reboot times out, and neither 1minutetip's
          # virsh nor its OpenStack console are reachable from this sandbox.
          # But Testing Farm DOES reliably capture whatever the guest itself
          # writes to /dev/console (every console-*.log gathered so far
          # proves this). So instead of chasing interactivity further, make
          # the guest keep dumping its own state to the serial console on a
          # tight loop for as long as anything is still being scheduled at
          # all. This has to be independent of local-fs.target -- that is
          # the suspected-hanging target -- so the unit below deliberately
          # does not order after it (or remote-fs.target/network.target).
          cat > /usr/local/bin/mls-debug-dump.sh <<'DUMPSCRIPT'
          #!/bin/sh
          # Installed by mls-debug-dump.service (see unit below). Every
          # ~4s, appends one timestamped snapshot straight to /dev/console
          # so it survives even if the guest never becomes SSH-reachable
          # again. Each diagnostic command is individually timeout-wrapped
          # so a single command stuck in the kernel (e.g. a blocked udev
          # ioctl) can never wedge the whole loop; Restart=always/
          # RestartSec=1 in the unit is the last-resort backstop if the
          # loop process itself dies anyway.
          exec >>/dev/console 2>&1

          first=1
          while :; do
              echo "=== mls-debug-dump @ $(timeout 3 date) ==="

              if [ "$first" = 1 ]; then
                  first=0
                  # ONE-SHOT, first iteration only: udevadm monitor is a
                  # blocking foreground stream, not a snapshot -- confirm
                  # uevents are still flowing at all near boot, then never
                  # run it again in this loop (the plain ps/systemctl
                  # snapshot below is what repeats every iteration).
                  echo "--- one-shot: udevadm monitor -u -k --property (bounded 8s) ---"
                  timeout 8 udevadm monitor -u -k --property 2>&1
                  echo "--- end one-shot udevadm monitor ---"
              fi

              echo "--- systemctl list-jobs ---"
              timeout 3 systemctl list-jobs --no-pager 2>&1

              echo "--- ps: udev/NetworkManager (pid ppid stat wchan cmd) ---"
              ps_dump=$(timeout 3 ps -eo pid,ppid,stat,wchan:32,cmd 2>&1)
              echo "$ps_dump" | grep -Ei 'udev|NetworkManager' || echo "(no matching udev/NetworkManager processes)"

              echo "--- journalctl -k --no-pager -n 5 ---"
              timeout 3 journalctl -k --no-pager -n 5 2>&1

              echo "=== end snapshot ==="
              sleep 4
          done
      DUMPSCRIPT
          chmod +x /usr/local/bin/mls-debug-dump.sh

          cat > /etc/systemd/system/mls-debug-dump.service <<'DUMPUNIT'
          [Unit]
          Description=Passive MLS enforcing-mode boot diagnostic dumper (writes snapshots to serial console)
          Documentation=man:systemd.special(7)
          # Modeled on systemd's own debug-shell.service: DefaultDependencies=no
          # and IgnoreOnIsolate=yes so this keeps running through an isolate to
          # rescue/emergency targets (exactly the failure mode this hang is
          # expected to land in), After=sysinit.target so it starts as early as
          # possible rather than waiting for multi-user.target (which may never
          # be reached if the hang prevents it). Deliberately NOT ordered after
          # local-fs.target/remote-fs.target/network.target: those are the
          # suspected-hanging targets, and this unit's whole purpose is to keep
          # running independent of them.
          DefaultDependencies=no
          IgnoreOnIsolate=yes
          After=sysinit.target

          [Service]
          Type=simple
          ExecStart=/usr/local/bin/mls-debug-dump.sh
          Restart=always
          RestartSec=1
          KillMode=process

          [Install]
          WantedBy=sysinit.target
      DUMPUNIT

          # Enable only -- do NOT start now. This unit is diagnosing the
          # *next* boot (the enforcing-mode one triggered by tmt-reboot
          # below), not this still-permissive one.
          systemctl enable mls-debug-dump.service

          cloud-init clean --logs
          sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
          tmt-reboot -t 1200
      fi

  - name: Verify enforcing-mode boot
    how: shell
    script: |
      echo "=== SELinux status ==="
      sestatus

      echo "=== dmesg | grep -i 'avc:\|denied' ==="
      dmesg_dump=$(dmesg 2>&1) || dmesg_dump="(dmesg failed to run)"
      echo "$dmesg_dump" | grep -i 'avc:\|denied' || echo "no matches in dmesg"

      echo "=== journalctl -k -b | grep -i 'avc:\|denied' ==="
      journalctl_k_dump=$(journalctl -k -b 2>&1) || journalctl_k_dump="(journalctl -k -b failed to run)"
      echo "$journalctl_k_dump" | grep -i 'avc:\|denied' || echo "no matches in journalctl"

      echo "=== AVC/USER_AVC denials this boot (ausearch) ==="
      # NOTE: "-ts boot" has proven unreliable here -- it silently missed
      # real AVCs that computing the actual boot time caught (see the
      # cloud-init socket-permission investigation in the execute step).
      #
      # ACTUAL ROOT CAUSE (superseding the clock-skew theory this branch
      # tried first): request 60da61ab (round 8, permissive rerun) showed
      # dmesg/journalctl -k -b catching several real AVCs in this exact
      # boot that "ausearch -ts $boot_ts" found zero records for -- but
      # inspecting that run's raw output directly (not just the "|| true"-
      # swallowed exit code) shows ausearch didn't return zero records, it
      # errored outright: "Invalid start time (08/24/2026 15:12:35). Hour,
      # Minute, and Second are required." `ausearch -ts` actually takes
      # start-date and start-time as TWO SEPARATE positional arguments
      # (`man ausearch`: "-ts, --start [start-date] [start-time]"); a
      # single shell-quoted "date time" string is treated entirely as the
      # *time* argument (date defaults to today), which then fails its own
      # %X time parse. Confirmed against upstream ausearch-time.c's
      # ausearch_time_start() and a matching public report (RHBZ#1197235,
      # "ausearch how to specify both time and date" on U&L Stack
      # Exchange) -- both show the exact same error text for the exact
      # same single-quoted-argument mistake. This means every "-ts
      # $boot_ts" query in this plan since 9fb65dd8 introduced the merged
      # form has actually been erroring out every single run, not
      # genuinely finding zero records -- silently masked by this step's
      # own "|| true"/"|| echo ..." guards. Fixed by passing date and time
      # as two separate arguments below; kept the previous commit's 60s
      # buffer regardless, since a wider "equal to or after" window is
      # harmless and still guards against any genuine clock-domain gap.
      boot_date=$(date -d "$(uptime -s) - 60 seconds" '+%m/%d/%Y' 2>/dev/null || echo today)
      boot_time=$(date -d "$(uptime -s) - 60 seconds" '+%H:%M:%S' 2>/dev/null || echo 00:00:00)
      avc_dump=$(ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>&1) || avc_dump="(ausearch found no records for this boot)"
      echo "$avc_dump"

      echo "=== any AVCs naming udev_t or NetworkManager_t specifically ==="
      # Rounds 1-6 concluded "not fixable via policy" from this exact query
      # coming back empty every time, but using "-ts boot"/"-ts recent",
      # both since proven to miss real AVCs (66856419/9fb65dd8). Round 7
      # re-ran this with the corrected boot_ts above (plus, independently,
      # a full serial-console kauditd_printk_skb capture -- see the
      # permissive-mark comments above) and still found nothing for either
      # domain. Kept permanently: marks make udev_t/NetworkManager_t immune
      # to enforcement, but permissive domains still log what would have
      # been denied (permissive=1), so this stays a free early-warning check
      # for any future re-litigation of the marks.
      echo "$avc_dump" | grep -Ei 'udev_t|NetworkManager_t' || echo "none"

      # ROUND 8: the check above only ever matched an exact
      # "udev_t"/"NetworkManager_t" scontext substring. Broadening for a
      # comprehensive sweep, against the same corrected boot_ts AVC dump
      # plus dmesg and journalctl -k -b for consistency with this
      # investigation's established multi-source approach: any scontext
      # mentioning udev, any tcontext mentioning udev-related types
      # (udev_var_run_t, udev_tbl_t, udev_exec_t, ...), any comm= mentioning
      # udev/systemd-udevd, and a general device/block-related object-class
      # grep (nvme, blk_file, chr_file) in case something relevant doesn't
      # literally say "udev" anywhere in the line. Kept permanently
      # alongside the narrower check above (same rationale: a free early-
      # warning signal for any future re-litigation of the marks) -- once
      # the ausearch invocation bug above was fixed, this sweep ran against
      # ~150 real AVC records from a full-system-permissive boot and found
      # nothing udev/NetworkManager-related beyond what's already
      # documented in this branch's history.
      echo "=== ROUND 8: comprehensive udev/device sweep of this boot's AVC dump ==="
      echo "--- by scontext (scontext=...udev...) ---"
      echo "$avc_dump" | grep -Ei 'scontext=[^ ]*udev' || echo "none"
      echo "--- by tcontext (tcontext=...udev...) ---"
      echo "$avc_dump" | grep -Ei 'tcontext=[^ ]*udev' || echo "none"
      echo "--- by comm= (udev, systemd-udevd, udevadm) ---"
      echo "$avc_dump" | grep -Ei 'comm="[^"]*(udev|systemd-udevd)[^"]*"' || echo "none"
      echo "--- by object class / device hints (nvme, blk_file, chr_file), regardless of udev mention ---"
      echo "$avc_dump" | grep -Ei 'nvme|blk_file|chr_file' || echo "none"

      echo "=== ROUND 8: same four-way sweep against dmesg ==="
      echo "--- by scontext ---"
      echo "$dmesg_dump" | grep -Ei 'scontext=[^ ]*udev' || echo "none"
      echo "--- by tcontext ---"
      echo "$dmesg_dump" | grep -Ei 'tcontext=[^ ]*udev' || echo "none"
      echo "--- by comm= ---"
      echo "$dmesg_dump" | grep -Ei 'comm="[^"]*(udev|systemd-udevd)[^"]*"' || echo "none"
      echo "--- by object class / device hints ---"
      echo "$dmesg_dump" | grep -Ei 'nvme|blk_file|chr_file' || echo "none"

      echo "=== ROUND 8: same four-way sweep against journalctl -k -b ==="
      echo "--- by scontext ---"
      echo "$journalctl_k_dump" | grep -Ei 'scontext=[^ ]*udev' || echo "none"
      echo "--- by tcontext ---"
      echo "$journalctl_k_dump" | grep -Ei 'tcontext=[^ ]*udev' || echo "none"
      echo "--- by comm= ---"
      echo "$journalctl_k_dump" | grep -Ei 'comm="[^"]*(udev|systemd-udevd)[^"]*"' || echo "none"
      echo "--- by object class / device hints ---"
      echo "$journalctl_k_dump" | grep -Ei 'nvme|blk_file|chr_file' || echo "none"

execute:
  how: tmt
  script: |
    echo "=== SELinux status ==="
    sestatus

    echo "=== waiting (up to 120s) for cloud-init to finish ==="
    timeout 120 cloud-init status --wait || true

    echo "=== cloud-init result ==="
    long_status=$(cloud-init status --long) || true
    echo "$long_status"

    echo "=== cloud-init running domain (expected: cloud_init_t) ==="
    ps -eZ | grep -i cloud || true

    # DIAGNOSTIC: cloud-init's boot activation is generator-only --
    # cloud-init.target ships with no static [Install] section, so it
    # relies on cloud-init-generator (or the static symlink workaround
    # above) pulling it into the boot transaction. Keeping these
    # permanently: "did cloud-init actually finish" needs a real check
    # every run, not just a passing diagnostic script.
    echo "=== cloud-init unit enablement/status ==="
    systemctl list-unit-files 'cloud-init*' 'cloud-config*' 'cloud-final*' || true
    systemctl status --no-pager cloud-init-local.service cloud-init-main.service cloud-config.service cloud-final.service || true

    echo "=== is cloud-init.target actually enabled/pulled into the boot? ==="
    systemctl show cloud-init.target -p ActiveState -p Wants || true
    ls -la /etc/systemd/system/multi-user.target.wants/cloud-init.target /run/systemd/generator*/multi-user.target.wants/cloud-init.target 2>&1 || true

    echo "=== cloud-init-generator's own log (ds-identify trace, written pre-journald) ==="
    cat /run/cloud-init/cloud-init-generator.log 2>&1 || echo "no cloud-init-generator.log"

    # DIAGNOSTIC: cloud-init-main.service listens on unix sockets under
    # /run/cloud-init/share (labeled net_conf_t, no cloudform-owned type
    # exists for it) for its stage shims (running as initrc_t) to signal
    # "start". cloudform.te now grants that connectto/write cross-domain,
    # but keep this cheap ls around -- it is exactly what exposed the gap
    # last time and costs nothing to check on every run.
    echo "=== /run/cloud-init/share ownership and SELinux labels ==="
    ls -laZ /run/cloud-init/share 2>&1 || true

    echo "=== failed units / stuck jobs this boot ==="
    systemctl --failed --no-pager || true
    systemctl list-jobs || true

    echo "=== journal for all cloud-init/cloud-config/cloud-final units ==="
    journalctl -u 'cloud-init*' -u 'cloud-config*' -u 'cloud-final*' -b --no-pager || true

    echo "=== audit2allow suggestions for any denials above ==="
    # NOTE: "-ts boot" silently missed real AVCs earlier in this same
    # investigation, and "-ts recent" (a fixed 10-minute window) can reach
    # back far enough to catch stale pre-MLS-switch entries whose
    # unconfined_u user context no longer exists under this loaded MLS
    # policy, which makes audit2allow choke and stop producing useful
    # output. Compute the actual current boot's start time instead, so
    # this only ever looks at AVCs from this boot.
    #
    # `-ts` takes start-date and start-time as two SEPARATE positional
    # arguments (see the longer root-cause writeup in the prepare step's
    # verify script) -- a single merged "date time" string here would
    # error out with "Invalid start time ... Hour, Minute, and Second are
    # required" exactly like it did there, silently swallowed by this
    # step's own "|| true"/"2>/dev/null" guards. Passing them separately,
    # plus the same 60s buffer as the prepare step for any genuine
    # clock-domain gap between early-boot audit records and this
    # `uptime -s`-derived boundary.
    boot_date=$(date -d "$(uptime -s) - 60 seconds" '+%m/%d/%Y' 2>/dev/null || echo today)
    boot_time=$(date -d "$(uptime -s) - 60 seconds" '+%H:%M:%S' 2>/dev/null || echo 00:00:00)
    ausearch -m AVC -ts "$boot_date" "$boot_time" 2>/dev/null | audit2allow || true

    echo "=== any AVCs naming cloud_init_t specifically (raw, in case audit2allow above choked) ==="
    ausearch -m AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -i cloud_init_t || echo "none"

    # REAL VERIFICATION: unlike everything above, this is not `|| true`.
    # Whether cloud-init actually finished under cloud_init_t is the
    # actual point of this plan -- a tmt "passed" verdict should mean
    # that happened, not just that the diagnostic script didn't crash.
    echo "=== final cloud-init verification ==="
    final_status=$(echo "$long_status" | awk -F': ' '/^status:/ {print $2}')
    echo "final status: $final_status"
    if [ "$final_status" != "done" ]; then
        echo "FAIL: cloud-init did not reach 'done' (got: '$final_status')"
        exit 1
    fi
    # cloud-init-main.service is short-lived (often gone within ~10s of
    # boot, well before this SSH execute step reconnects), so both `ps -eZ`
    # and journald's per-message SELinux context proved too racy/unreliable
    # to catch it after the fact. Instead read back the bootcmd-captured
    # `id -Z`, which ran as a direct subprocess of cloud-init itself (see
    # 98-selinux-context-check.cfg in prepare) and so reflects the domain
    # cloud-init genuinely executed in, not a snapshot taken after it exited.
    echo "=== cloud-init's own SELinux context (captured via bootcmd) ==="
    context_log=$(cat /var/log/cloud-init-selinux-context.log 2>&1) || true
    echo "$context_log"
    if ! echo "$context_log" | grep -q cloud_init_t; then
        echo "FAIL: cloud-init reported done, but no evidence it ever ran under cloud_init_t"
        exit 1
    fi
    echo "PASS: cloud-init reached 'done' and ran under cloud_init_t"

    # FORENSICS (fallback per the pivot investigating mls-fix-udev-only-
    # permissive's "/bin/bash: Permission denied" signature): that branch's
    # own reboot into enforcing never completes far enough to reach this
    # execute step at all, so its would-be evidence is unreachable directly.
    # This branch (mls-fix, both domains permissive) DOES reach a stable,
    # fully-booted, SSH-reachable enforcing-mode state -- check here whether
    # the same denial class exists but stays latent/permissive-logged rather
    # than enforced, which would mean it's present on both branches and just
    # not yet fatal on this one.
    echo "=== FORENSICS: comm=bash or comm=sshd AVCs this boot (any class/permission) ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'comm="(bash|sshd|login|sshd-session)"' || echo "none"

    echo "=== FORENSICS: process class transition/dyntransition/entrypoint/noatsecure denials this boot ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'class=process.*(transition|dyntransition|entrypoint|noatsecure|rlimitinh|siginh)' || echo "none"

    echo "=== FORENSICS: file-class execute/execute_no_trans/entrypoint denials on bin_t/shell_exec_t this boot ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'class=file.*(execute|entrypoint)' || echo "none"

    # FORENSICS (pipe/fd handoff theory): sshd-session hands a login shell
    # its stdin/stdout pipes, then dyntransitions the process into the
    # user's role (e.g. sysadm_t) before exec'ing the shell. Reviewing
    # userdom_dyntransition_admin_users (userdomain.if) shows it grants
    # ONLY "allow $1 admindomain:process dyntransition" -- unlike the
    # analogous userdom_xsession_spec_domtrans_unpriv_users interface,
    # which explicitly bundles fd:use + fifo_file perms + sigchld alongside
    # the transition itself. mlssshpipes.te (this repo's backport of
    # upstream a589b1b5/#3286) only adds "domain -> sshd_session_t:fifo_file
    # rw_inherited_fifo_file_perms" -- it does NOT grant "fd use", and
    # nothing else in the tree grants sysadm_t/admindomain fd:use on
    # sshd_session_t either. If that gap is real, the kernel's own
    # exec-time fd flush (not an EACCES on execve itself) would likely
    # just silently close the inherited stdio fds rather than produce the
    # literal "/bin/bash: Permission denied" text -- so this class of
    # denial is plausible but not a proven match for that exact string.
    # Check for it directly rather than reason about it further.
    echo "=== FORENSICS: class=fd denials this boot (pipe/fd handoff theory) ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'class=fd\b' || echo "none"

    echo "=== FORENSICS: class=fifo_file denials this boot ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'class=fifo_file\b' || echo "none"

    echo "=== FORENSICS: class=unix_stream_socket or unix_dgram_socket denials this boot ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'class=unix_(stream|dgram)_socket\b' || echo "none"

    echo "=== FORENSICS: class=capability denials this boot ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null | grep -Ei 'class=capability\b' || echo "none"

    echo "=== FORENSICS: full raw AVC/USER_AVC dump this boot (unfiltered, for anything the greps above miss) ==="
    ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>&1 || echo "no AVCs this boot"

    echo "=== FORENSICS: semanage login -l (confirm root's actual SELinux user mapping) ==="
    semanage login -l 2>&1 || echo "semanage login -l failed"

    echo "=== FORENSICS: id -Z for this execute step's own login session (sshd->shell transition already happened to get here) ==="
    id -Z 2>&1 || echo "id -Z failed"

    echo "=== FORENSICS: /bin/bash and /usr/bin/bash file contexts ==="
    ls -laZ /bin/bash /usr/bin/bash 2>&1 || echo "ls -laZ failed"

    echo "=== FORENSICS: sesearch -- sysadm_r/sysadm_t executing bin_t/shell_exec_t (TE rules only, not MLS constraints) ==="
    (sesearch -A -s sysadm_t -t bin_t -c file 2>&1; sesearch -A -s sysadm_t -t shell_exec_t -c file 2>&1) || echo "sesearch unavailable/failed"

    echo "=== FORENSICS: sesearch -- sshd_t process transition/dyntransition into sysadm_t ==="
    (sesearch -A -s sshd_t -t sysadm_t -c process 2>&1) || echo "sesearch unavailable/failed"
