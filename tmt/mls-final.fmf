summary: MLS Enforcing-Mode Boot Validation (minimal)
description: |
    Switches a Fedora guest from the default targeted SELinux policy to
    mls and validates a working, SELinux-enforcing boot with cloud-init
    and networking functional. This is the minimal, production version
    of the fix set developed in tmt/mls.fmf (same directory); see that
    file's git history for the full investigation behind these fixes.

prepare:
  - name: Install and configure MLS policy in Permissive mode
    how: shell
    script: $TMT_TREE/tmt/mls-final-prepare-1-mls-permissive.sh

  - name: Build and load cloud-init, sshd-session-pipes, and udev_t policy fixes
    how: shell
    script: $TMT_TREE/tmt/mls-final-prepare-2-build-modules.sh

  - name: Reboot to apply MLS and relabel
    how: shell
    script: $TMT_TREE/tmt/mls-final-prepare-3-reboot-relabel.sh

  - name: Switch to Enforcing and reboot again
    how: shell
    script: $TMT_TREE/tmt/mls-final-prepare-4-enforcing.sh

execute:
  how: tmt
  script: $TMT_TREE/tmt/mls-final-execute.sh
