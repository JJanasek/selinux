summary: MLS Enforcing-Mode Boot Validation (minimal)
description: |
    Switches a Fedora guest from the default targeted SELinux policy to
    mls and validates a working, SELinux-enforcing boot with cloud-init
    and networking functional.

    This is the minimal, production version of the fix set developed in
    tmt/mls.fmf (same directory) -- it keeps only what's actually needed
    for a passing run: the two real policy fixes (udev_t/NetworkManager_t
    permissive marks, and enabling the ssh_sysadm_login boolean so root's
    SSH session can actually reach sysadm_t), the custom policy modules,
    and the cloud-init/reboot mechanics. All of the diagnostic scaffolding
    that was needed to *find* those fixes (the serial-console dumper,
    exhaustive AVC/sesearch forensics, debug-verbosity boot args, the
    chronological "ROUND N" investigation notes) has been dropped here;
    see tmt/mls.fmf's git history for that full story.

prepare:
  - name: Install and configure MLS policy in Permissive mode
    how: shell
    script: |
      dnf install -y selinux-policy-mls policycoreutils-python-utils audit

      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_configure

      # Stay permissive for the initial relabel reboot
      sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config

      # Preserve SSH host keys across reboots to maintain tmt connection
      mkdir -p /etc/cloud/cloud.cfg.d
      echo 'ssh_deletekeys: false' > /etc/cloud/cloud.cfg.d/99-preserve-ssh-host-keys.cfg

      # Capture the SELinux context cloud-init actually runs under via a
      # bootcmd subprocess (inherits cloud-init's live domain with no exec
      # transition of its own) -- cloud-init-main.service is short-lived
      # and often gone before the execute step reconnects, so this is the
      # only non-racy way to confirm it ran under cloud_init_t.
      cat > /etc/cloud/cloud.cfg.d/98-selinux-context-check.cfg <<'CICFG'
      bootcmd:
        - [ sh, -c, "id -Z > /var/log/cloud-init-selinux-context.log 2>&1" ]
      CICFG

      # Reset cloud-init state to force a full run under MLS
      cloud-init clean --logs

  - name: Build and load cloud-init and sshd-session-pipes policy fixes
    how: shell
    script: |
      dnf install -y policycoreutils-devel

      # Stage missing interface files
      cp $TMT_TREE/tmt/mls-cloudinit-fix/networkmanager-manage-rw-conf.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/ssh-read-server-keys.if /usr/share/selinux/devel/include/contrib/
      cp $TMT_TREE/tmt/mls-cloudinit-fix/sysnetwork-manage-config-sockets.if /usr/share/selinux/devel/include/system/

      mkdir -p /root/build && cd /root/build
      cp $TMT_TREE/tmt/mls-cloudinit-fix/cloudform.* .
      cp $TMT_TREE/tmt/mls-ssh-pipes-fix/mlssshpipes.te .
      cp $TMT_TREE/tmt/mls-udev-ptrace-fix/udevptrace.te .

      make -f /usr/share/selinux/devel/Makefile cloudform.pp mlssshpipes.pp udevptrace.pp

      # Load modules into the inactive MLS store (-n) without hot-reloading
      semodule -n -i cloudform.pp mlssshpipes.pp udevptrace.pp
      semodule -l | grep -E '^(cloudform|mlssshpipes|udevptrace)\b'

  - name: Reboot to apply MLS and relabel
    how: shell
    script: |
      source $TMT_TREE/tmt/prepare_for_mls.sh
      prepare_for_mls_reboot
      prepare_for_mls_force_relabel

  - name: Switch to Enforcing and reboot again
    how: shell
    script: |
      if [ "${TMT_REBOOT_COUNT:-0}" -eq 0 ]; then
          rm -f /.autorelabel
          systemctl mask selinux-autorelabel.service

          # Empirically required: a dedicated bisection test that removed
          # only these two marks (ssh_sysadm_login on, fstab tuning kept)
          # reproduced a full boot hang (no SSH, no network reachability
          # at all for 10+ min) -- yet 8 rounds of AVC auditing, including
          # with dontaudit off, never caught a denial explaining why.
          # Mechanism not understood: possibly a race/timing effect, or
          # something outside what audit records. Keep as a pair; only
          # tested/confirmed together, not individually.
          semanage permissive -n -a udev_t
          semanage permissive -n -a NetworkManager_t

          # THE fix: root's SSH session maps to sysadm_u/sysadm_r/sysadm_t
          # (semanage login -l), but sshd_session_t's ability to
          # transition into any admin domain is gated behind this tunable
          # (off by default). Without it, every post-reboot SSH command
          # fails execve() with a denied process "transition" AVC,
          # surfacing to users as a flat "/bin/bash: Permission denied" --
          # and, since tmt's own reboot-detection also runs over SSH, this
          # alone was enough to make the enforcing-mode reboot look like
          # it hung. See tmt/mls.fmf's git history for the full
          # investigation that found this.
          semanage boolean -n -m --on ssh_sysadm_login

          # (fstab UUID->device rewrite + nofail,device-timeout tuning was
          # tested and removed: a dedicated run with both marks above kept
          # and this tuning entirely absent booted cleanly in ~24s with
          # NetworkManager/systemd-udevd active and zero AVCs. It was
          # speculative boot-timing scaffolding with no evidence behind
          # it, unlike the two marks above.)

          # Defense-in-depth alongside the real fix in cloudform.te:
          # cloud-init.target ships with no static [Install] section, so
          # give it a static symlink in case the generator's own runtime
          # enablement doesn't run.
          mkdir -p /etc/systemd/system/multi-user.target.wants
          ln -sf /usr/lib/systemd/system/cloud-init.target /etc/systemd/system/multi-user.target.wants/cloud-init.target

          # Rebuild the policy store now so the boolean/permissive changes
          # above are baked into what the reboot below actually loads.
          # (dontaudit is left at its default -- on -- to keep production
          # audit logs quiet; nothing in this minimal plan depends on
          # seeing dontaudited denials.)
          semodule -DB

          cloud-init clean --logs
          sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
          tmt-reboot -t 1200
      fi

execute:
  how: tmt
  script: |
    echo "=== SELinux status ==="
    sestatus

    echo "=== waiting (up to 120s) for cloud-init to finish ==="
    timeout 120 cloud-init status --wait || true

    long_status=$(cloud-init status --long) || true
    final_status=$(echo "$long_status" | awk -F': ' '/^status:/ {print $2}')
    echo "=== cloud-init final status: $final_status ==="

    # REAL VERIFICATION #1: cloud-init must actually finish. A tmt
    # "passed" verdict should mean that happened, not just that this
    # script ran without crashing.
    if [ "$final_status" != "done" ]; then
        echo "FAIL: cloud-init did not reach 'done' (got: '$final_status')"
        exit 1
    fi

    # REAL VERIFICATION #2: confirm it ran under cloud_init_t, via the
    # bootcmd-captured id -Z from prepare (see 98-selinux-context-check.cfg)
    # -- cloud-init-main.service is too short-lived to catch with ps -eZ
    # after the fact.
    context_log=$(cat /var/log/cloud-init-selinux-context.log 2>&1) || true
    echo "=== cloud-init's own SELinux context (captured via bootcmd): $context_log ==="
    if ! echo "$context_log" | grep -q cloud_init_t; then
        echo "FAIL: cloud-init reported done, but no evidence it ever ran under cloud_init_t"
        exit 1
    fi
    echo "PASS: cloud-init reached 'done' and ran under cloud_init_t"

    # Lightweight regression tripwire (not exhaustive forensics, and not
    # part of the pass/fail gate -- some non-blocking denials, e.g. minor
    # process:{noatsecure,siginh} on the sshd auth helper chain, are
    # expected and harmless even on a fully working boot). Report the
    # count and full dump so a human can review; a plan run isn't failed
    # over this alone.
    boot_date=$(date -d "$(uptime -s) - 60 seconds" '+%m/%d/%Y' 2>/dev/null || echo today)
    boot_time=$(date -d "$(uptime -s) - 60 seconds" '+%H:%M:%S' 2>/dev/null || echo 00:00:00)
    avc_dump=$(ausearch -m AVC,USER_AVC -ts "$boot_date" "$boot_time" 2>/dev/null)
    avc_count=$(echo "$avc_dump" | grep -c '^type=AVC\|^type=USER_AVC')
    echo "=== AVC/USER_AVC denials this boot: $avc_count (informational only) ==="
    [ "$avc_count" -gt 0 ] && echo "$avc_dump"
