policy_module(udevrange, 1.0.0)

# EXPERIMENT: upstream udev.te's own MLS range-restriction call --
# kernel_ranged_domtrans_to(udev_t, udev_exec_t, s0 - mcs_systemhigh) /
# init_ranged_daemon_domain(udev_t, udev_exec_t, s0 - mcs_systemhigh)
# -- is wrapped in `ifdef(\`enable_mcs\', ...)` only. MLS builds fall
# through to the unranged kernel_domtrans_to()/init_daemon_domain()
# calls a few lines above it in udev.te, so udev_t simply inherits
# whatever range kernel_t/init_t happen to be running at when they
# exec it -- verified live (`ps -eZ`, `seinfo -x -t`) to be the full
# s0-s15:c0.c1023 clearance on this guest.
#
# Note the upstream MCS macro call itself is *not* actually a
# restriction either way: "s0 - mcs_systemhigh" (MCS) and
# "s0 - mls_systemhigh" (its literal MLS equivalent, used elsewhere in
# this same policy, e.g. xserver.te/init.if) both spell out the full
# unrestricted range top-to-bottom -- so simply porting that macro
# call verbatim to the enable_mls branch would be a no-op for the
# performance question this module actually tests. This instead pins
# udev_t to a genuinely single, low level: plain "s0" (l2 == h2 == s0),
# with no dash and no categories, which upstream does NOT do for
# udev_t under either MCS or MLS.
#
# Checked this is policy-safe *before* testing, against the actual
# mlsconstrain/mlsvalidatetrans expressions in policy/mls:
# - process transition (the exec-time check this range_transition
#   itself is subject to): requires `l1 eq l2` (or a privrangetrans/
#   mlsrangetrans pair udev_t doesn't have) -- passes because
#   kernel_t/init_t's own *current* low level is s0, matching udev_t's
#   new pinned s0, independent of their much higher clearance.
# - every file mlsconstrain read/write/relabelto/create op, and the
#   file mlsvalidatetrans (upgrade/downgrade): udev_t already carries
#   the mlsfileread/mlsfilewrite/mlsfileupgrade/mlsfiledowngrade
#   attributes (mls_file_read_all_levels()/mls_file_write_all_levels()/
#   mls_file_upgrade()/mls_file_downgrade() in udev.te), each an
#   unconditional `t1 ==`/`t2 ==` OR-branch that does not reference
#   udev_t's own l1/h1 at all -- so dropping udev_t's clearance from
#   the full range down to s0 removes none of the file access those
#   attributes already grant.
# - process write ops (sigkill/signal/setsched/ptrace-write/etc):
#   udev_t already carries mlsprocwrite (mls_process_write_down() ->
#   mls_process_write_all_levels() in udev.te), also an unconditional
#   `t1 ==` branch independent of l1/h1.
# - process read ops (getsched/getpgid/getattr/ptrace-read/share) are
#   the one class udev_t has no blanket attribute for; they gate on
#   `l1 dom l2` alone. l1 is udev_t's range's *low* end, which is s0
#   whether the range is pinned to plain s0 or left at the full
#   s0-s15:c0.c1023 -- identical either way, so this pin does not
#   change their outcome.
#
# In short: only udev_t's clearance (h1) actually changes here, and
# nothing in policy/mls conditions an existing udev_t grant on h1
# without also granting it unconditionally via one of the attributes
# above -- so this is not expected to introduce new denials, only to
# test whether a narrower target range reduces range_transition/
# dominance-math overhead during udev's early device-enumeration
# burst enough to matter for the dev-nvme0n1p2/p3.device timeout this
# investigation is chasing.

gen_require(`
	type udev_t, udev_exec_t, kernel_t, init_t;
')

range_transition kernel_t udev_exec_t:process s0;
range_transition init_t udev_exec_t:process s0;
