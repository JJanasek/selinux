policy_module(mlssshpipes, 1.0)

# Backport of fedora-selinux/selinux-policy commit a589b1b5 (fixing
# fedora-selinux/selinux-policy#3286), not yet in
# selinux-policy-mls-44.6-1.fc44: lets a confined domain read/write the
# pipes OpenSSH's privilege-separated sshd-session hands a login shell as
# stdin/stdout. Needed for sysadm_t (root's mls login domain); invisible
# under targeted since root's session there is unconfined_t.

gen_require(`
	attribute domain;
	type sshd_session_t;
')

allow domain sshd_session_t:fifo_file rw_inherited_fifo_file_perms;
