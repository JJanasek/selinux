[Unit]
Description=Diagnostic: live udevadm monitor + active re-trigger for the stuck non-root device
DefaultDependencies=no
After=systemd-udevd.service
Before=shutdown.target

[Service]
Type=simple
StandardOutput=journal+console
StandardError=journal+console
# Runs for the whole boot: a background `udevadm monitor` line for every
# kernel/udev event (so we can see directly whether the kernel uevent for
# the stuck device ever arrives, and whether udev ever finishes processing
# it), plus a delayed foreground probe once we're past the point where the
# by-uuid/by-raw-device mount is already known to still be stuck (~45s),
# that inspects the udev device DB directly and tries an active re-trigger.
ExecStart=/bin/sh -c '\
    echo "=== mls-udev-monitor: starting live kernel+udev event monitor ==="; \
    (udevadm monitor --kernel --udev --property 2>&1 | while IFS= read -r line; do \
        stamp=$(date +%%s.%%3N); \
        printf "[mls-udev-monitor %%s] %%s\n" "$stamp" "$line"; \
    done) & \
    monitor_pid=$!; \
    sleep 45; \
    name=$(ls /sys/class/block/ 2>/dev/null | grep "p3$" | head -1); \
    echo "=== mls-udev-monitor: t+45s snapshot for $name ==="; \
    echo "--- udev device DB entry (udevadm info) ---"; \
    timeout 15 udevadm info --query=all --name="/dev/$name" 2>&1; \
    echo "info exit=$?"; \
    echo "--- /run/udev/data directory listing + contexts ---"; \
    ls -laZ /run/udev/data/ 2>&1; \
    echo "--- /run/udev/data dir itself: context ---"; \
    ls -ldZ /run/udev /run/udev/data 2>&1; \
    echo "--- ps -eZ: is a udev worker stuck right now? ---"; \
    ps -eZ 2>&1 | grep -i udev; \
    echo "--- active re-trigger: udevadm trigger --verbose --action=add ---"; \
    time timeout 30 udevadm trigger --verbose --action=add "/sys/class/block/$name" 2>&1; \
    echo "trigger exit=$?"; \
    echo "--- udevadm settle (bounded 30s): does the queue ever drain? ---"; \
    time timeout 30 udevadm settle --timeout=25 2>&1; \
    echo "settle exit=$?"; \
    echo "--- did the raw device / by-uuid symlink appear after the manual trigger? ---"; \
    ls -la "/dev/$name" /dev/disk/by-uuid/ 2>&1; \
    echo "=== mls-udev-monitor: t+45s probe done, monitor continues in background (pid $monitor_pid) ==="; \
    wait $monitor_pid'

[Install]
WantedBy=sysinit.target
