## <summary>Additional ssh interface needed by the cloudform module cloud-init fix.</summary>
##
## <summary>
## This is a standalone copy of the new ssh_read_server_keys interface
## added to ssh.if on JJanasek/selinux-policy at mls-enable-cloud-init.
## It is shipped as its own file here (instead of overwriting the
## installed ssh.if) because the devel Makefile picks up every .if file
## under each header layer directory, so dropping this in alongside the
## stock ssh.if is enough for cloudform.te to see it at compile time,
## with no need to touch or replace anything already installed.
## </summary>

#######################################
## <summary>
##	Read ssh server keys
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`ssh_read_server_keys',`
	gen_require(`
		type sshd_key_t;
	')

	read_files_pattern($1, sshd_key_t, sshd_key_t)
')
